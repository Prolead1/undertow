# Data & artifacts: the validated datasets under data/datasets/ are tracked so a
# fresh clone can run the sim/backtester without re-pulling (ZSTD parquet; ~1.1 GB
# total). These negations come FIRST so every later junk rule (__pycache__,
# .mypy_cache, …) still applies underneath the dataset tree.
/data/*
!/data/datasets/
!/data/datasets/**

# Python / uv
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Data & artifacts (continued): caches and intermediate artifacts stay local.
/data/raw/
/data/processed/
/data/cache/
# Training runs and evaluation outputs (checkpoints, telemetry, rollouts).
# Anchored to the repo root so the tracked scripts/smoke_fixture/runs/ is kept.
/runs/
/results/
*.parquet
*.parquet.gzip
*.arrow
*.sqlite
*.db
# …but the checked-in dataset parquet is intentional (the negation must come after
# the global *.parquet rule to win).
!/data/datasets/**/*.parquet

# Logs & notebooks scratch
logs/
*.log
.ipynb_checkpoints/

# Pi agent config (local only — never commit)
.pi/
.env

# OS
.DS_Store

# Coverage artifacts
.coverage

# Frontend (ui-v1) — isolated Node toolchain under web/.
# No trailing slash: `web/node_modules` is commonly a symlink to the main
# checkout, and a trailing slash only matches a real directory, not a symlink.
node_modules
web/node_modules
web/dist
*.tsbuildinfo

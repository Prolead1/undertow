# LaTeX aux files - build products, never commit.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.run.xml
*-blx.bib

# `main.pdf` is committed on purpose: the repository keeps a current rendering
# of the report. Rebuild it with scripts/build_report.sh after every edit.

# PNG copies of the figures are inspection aids; the committed figures are PDF.
/figures/*.png
